# Apex 环境变量示例
# ⚠️ 这是示例文件，请勿提交真实值到仓库
# 生产环境部署时，所有 *_SECRET / *_KEY 必须通过 Cloudflare Dashboard 或 wrangler secret 注入

# 运行环境：production / development
ENVIRONMENT=development

# 站点公开地址（用于邮件链接 / CSP / canonical / OG）
PUBLIC_BASE_URL=https://example.com

# CORS 允许来源（逗号分隔）。留空 = 同源策略，禁止跨域读取。
# 生产环境建议留空或仅填生产域名。
ALLOWED_ORIGINS=

# CAPTCHA 签名密钥（32+ 字节随机十六进制，64 位 hex 最佳）
# 生成：openssl rand -hex 32
CAPTCHA_SECRET=change-me-32-bytes-hex

# CAPTCHA IP 哈希额外盐（可选，留空则用 CAPTCHA_SECRET 代替）
CAPTCHA_SALT=

# 邮件服务商顺序：resend, agentmail（逗号分隔，按顺序尝试）
EMAIL_PROVIDER=resend,agentmail

# 发件人信息（必须与你已验证的发送域一致）
EMAIL_FROM=Apex Entertainment <noreply@example.com>
EMAIL_REPLY_TO=support@example.com

# Resend（主）
RESEND_API_KEY=re_xxx

# AgentMail（备）
AGENTMAIL_API_KEY=am_us_xxx
AGENTMAIL_INBOX_ID=inbox_xxx

# 开发模式下是否允许在 API 响应中返回 reset code / verify token
# 生产环境必须为 false
DEV_SHOW_RESET_CODE=false

# ==== 各用途独立的随机盐（生产必填，且互不相同）====
# 生成方式示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SALT=
AUDIT_SALT=
RATE_LIMIT_SALT=
