# ==== Git 忽略规则（同时反映部署排除）====

# 源码导出/备份
Apex_*.txt
Apex_*.md
*.bak
*.bak_*
*.backup
*.orig

# 备份
backups/*.sql
backups/*.sql.gz
backups/*.sha256
backups/*.dump

# 本地环境
.dev.vars
.env
.env.local
.env.*.local
!.env.example

# Wrangler
.wrangler/

# 测试缓存 / 覆盖率
tests/.cache/
coverage/

# 依赖
node_modules/

# 日志
*.log

# 系统文件
.DS_Store
Thumbs.db
*.swp
*~

# 临时
tmp/
.cache/

# 大图片备份（本地优化前的原图，不部署）
*.orig.png
*.orig.jpeg
*-full.jpeg
*-full.png
*.removed

# 恢复测试临时目录
.restore-work/

# 部署产物目录（由 scripts/build-dist.sh 生成）
dist/
