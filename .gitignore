# ==== Git 忽略规则（同时反映部署排除）====

# 源码导出/备份
Apex_*.txt
Apex_*.md
*.bak
*.bak_*
*.backup
*.orig

# 备份
backups/*.sql
backups/*.sql.gz
backups/*.sha256
backups/*.dump

# 本地环境
.dev.vars
.env
.env.local
.env.*.local
!.env.example

# Wrangler
.wrangler/

# 测试缓存 / 覆盖率
tests/.cache/
coverage/

# 依赖
node_modules/

# 日志
*.log

# 系统文件
.DS_Store
Thumbs.db
*.swp
*~

# 临时
tmp/
.cache/

# 大图片备份（本地优化前的原图，不部署）
*.orig.png
*.orig.jpeg
*-full.jpeg
*-full.png
*.removed

# 恢复测试临时目录
.restore-work/

# 部署产物目录（由 scripts/build-dist.sh 生成）
dist/
# 补充：形如 xxx.js.bak.1700000000 的时间戳备份
*.bak.*
# 上游工具不支持的配置文件（本地保留，不部署）
*.not-supported-by-pages

# ===== Apex migrations 本地临时文件 =====
migrations/_local_backup_*/
migrations/_archive_old_*/

# Apex 审计：不部署根目录 sw.js、源码导出、审计结果
audit-results-*/

# ===== Apex 审计备份目录（自动排除，避免污染 git 状态）=====
.audit-backup-*/
.archive/

# Apex: 未使用的 LQIP 缩略图（生成工具副产物）
login-hero-lqip.webp

previews/
.audit-fix/

# 本地清理脚本备份目录
.cleanup-backup-*/

# 旧游戏 replay 系统残留目录（不再使用）
replays/
apex-game-bundle.md
apex-game-*.tar.gz
*.tar.gz
*.tgz
APEX_FULL_CODE*
apex-game-v1*.tar.gz

# ===== P0 phase artifacts =====
audit-logs/

# ===== P0-P3: local backup FILES (not just dirs) =====
.audit-backup-*.js
.audit-backup-*.cjs
.audit-backup-*.md
.audit-backup-*.json
.audit-backup-*.txt
.audit-backup-*
