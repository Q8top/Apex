# ============================================================
# Cloudflare Pages 重定向规则
# 优先级：高于静态文件 → 用于阻断源码/配置泄露
# 语法：<source>  <destination>  <status>
# ============================================================

# --- 源码 / 配置 / 部署产物：直接 404 ---
/wrangler.toml            /404.html  404
/package.json             /404.html  404
/package-lock.json        /404.html  404
/.assetsignore            /404.html  404
/_routes.json             /404.html  404
/.gitignore               /404.html  404
/README.md                /404.html  404

# --- 全目录级阻断（含通配符）---
/functions/*              /404.html  404
/migrations/*             /404.html  404
/scripts/*                /404.html  404
/tests/*                  /404.html  404
/docs/*                   /404.html  404
/src/*                    /404.html  404
/backups/*                /404.html  404
/.wrangler/*              /404.html  404
/.git/*                   /404.html  404
/.github/*                /404.html  404
/.archive/*               /404.html  404
/.restore-work/*          /404.html  404
/node_modules/*           /404.html  404

# --- 环境 / 源码导出 / 备份 ---
/.env                     /404.html  404
/.env.*                   /404.html  404
/.dev.vars                /404.html  404
/.dev.vars.*              /404.html  404
/Apex_*.txt               /404.html  404
/Apex_*.md                /404.html  404

# --- 大小写变体兜底（Windows 上传/或暴力枚举）---
/WRANGLER.TOML            /404.html  404
/Package.json             /404.html  404

# --- SPA fallback：所有其它未匹配的浏览器路由 → index.html（200）---
/*                        /index.html  200
