/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self'; media-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests; report-uri /api/csp-report

/api/*
  Cache-Control: no-store

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML 页面（无缓存，保证用户看到最新版本）
/
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/index.html
  Cache-Control: no-cache

/privacy.html
  Cache-Control: public, max-age=3600

/terms.html
  Cache-Control: public, max-age=3600

/status.html
  Cache-Control: no-cache


# PWA manifest：短期缓存
/manifest.json
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json; charset=utf-8

# robots / sitemap：短期缓存
/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

# 404 页面：不缓存
/404.html
  Cache-Control: no-cache

# Service Worker：自杀版也必须 no-cache，让浏览器每次拉取最新版
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

# === APEX-CACHE-IMAGES ===
# Hero 大图：WebP 主，JPEG fallback。文件名固定，
# 更新时应配合内容 hash 或重命名（见 scripts/hash-assets.mjs）。
/login-hero.webp
  Cache-Control: public, max-age=604800

/login-hero.jpeg
  Cache-Control: public, max-age=604800
/logo.webp
  Cache-Control: public, max-age=604800

/logo.png
  Cache-Control: public, max-age=604800

/logo-home.webp
  Cache-Control: public, max-age=604800

/logo-home.png
  Cache-Control: public, max-age=604800

/splash-top.webp
  Cache-Control: public, max-age=604800

/splash-top.jpeg
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

# 本地字体（woff2）：1 年不可变缓存
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# === APEX-CACHE-SRC ===
/src/css/*
  Cache-Control: public, max-age=86400

/src/js/*
  Cache-Control: public, max-age=86400

/i18n/*
  Cache-Control: public, max-age=3600
# === APEX-CACHE-END ===
