name = "apex"
pages_build_output_dir = "."
compatibility_date = "2026-09-01"
compatibility_flags = ["nodejs_compat"]

[[d1_databases]]
binding = "apex_db"
database_name = "apex-db"
database_id = "1b144350-08a0-40cb-b4a5-1356ca53fadb"

[vars]
ENVIRONMENT = "production"
PUBLIC_BASE_URL = "https://apextop.cc.cd"
EMAIL_FROM = "Apex Entertainment <noreply@notify.apextop.cc.cd>"

# ============================================================
# Preview / Staging 环境骨架
# ============================================================
# 部署时使用：wrangler pages deploy . --env=preview
#
# ⚠️ 上线前必须做的事：
#   1. 在 Cloudflare 控制台创建独立的 preview D1 库
#   2. 把下方 database_id 替换为真实的 preview 库 id
#   3. 在 Pages 控制台为 preview 环境单独设置 CAPTCHA_SECRET / PUBLIC_BASE_URL / EMAIL_FROM
#      （绝不能复用生产环境的值）
#
# [env.preview]
# name = "apex-preview"
# [[env.preview.d1_databases]]
# binding = "apex_db"
# database_name = "apex-db-preview"
# database_id = "<待填：独立 preview D1 database_id>"
# [env.preview.vars]
# ENVIRONMENT = "preview"
# PUBLIC_BASE_URL = "https://preview.apextop.cc.cd"
# EMAIL_FROM = "Apex Preview <noreply@preview.apextop.cc.cd>"
